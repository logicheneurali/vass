# translate.vass - translate text into specified language and copy to clipboard
$target = trim($param1)
$text = trim($param2)
ifempty($text, exit(), "")
ifempty($target, exit(), "")
say($_exec_message)
$result = ai_raw("Translate the following text to {$target}: {$text}. Only return the translation, no extra text, no quotes, no markdown.")
$result = trim($result)
print($result)
clipboardset($result)
wait(1)
$check = trim(clipboardget())
$ok = ifcontains($check, $result, "True", "False")
ifcontains($ok, "True", say($_tr_ok), say($_tr_fail))
say($result)

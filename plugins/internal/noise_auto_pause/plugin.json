{
  "name": "noise_auto_pause",
  "version": "1.0.0",
  "type": "internal",
  "description": "Noise detection and auto-pause — pauses listening when ambient noise is too high",
  "author": "VASS",
  "entry_point": "plugin.py",
  "plugin_class": "NoiseAutoPausePlugin",
  "depends_on": [],
  "provides": ["noise_auto_pause"],
  "config_section": "[noise]",
  "settings_defaults": {
    "noise": {"noise_pause": "false", "noise_pause_threshold": "0.02", "noise_pause_duration": "30"}
  },
  "threads": [],
  "gui_windows": {},
  "hooks": ["on_load", "on_unload", "on_settings_change"],
  "loop_hook": true,
  "min_app_version": "0.6.7"
}

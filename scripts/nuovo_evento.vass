# nuovo_evento.vass
say("Data inizio evento?")
$dat=listen()
say("Descrizione dell'evento?")
$descr=listen()
say("a che ora?")
$time=listen()
say("durata?")
$dur=listen()
say("ricorrenza?")
$rec=listen()
$ret=ai("prima utilizza il tool datetime per ottenere data e ora attuale. poi utilizza il tool interact per aggiungere un evento. inizio_evento è {$dat} (converti in una data valida nel formato 'YYYY-MM-DD' se necessario), ora_evento è '{$time}' (converti in hh:mm se necessario), durata_evento è {$dur} (converti in minuti), descrizione_evento è '{$descr}', ricorrenza_evento è {$rec} (se nessuna o non specificata diventa \"\").")
say($ret)
